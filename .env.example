# Copy to .env and adjust. Never commit .env.
GTFS_API_BASE=https://api.data.gov.my
GTFS_CATEGORY=rapid-bus-kl

# Postgres (docker-compose.yml uses these, with the same defaults)
POSTGRES_USER=transit
# Change this on any server (the default is only for local development).
POSTGRES_PASSWORD=transit
POSTGRES_DB=transit
POSTGRES_PORT=5432
# Used by the app and Alembic when running outside Docker
DATABASE_URL=postgresql+psycopg://transit:transit@127.0.0.1:5432/transit
# Used by DB tests (skipped if unset)
TEST_DATABASE_URL=postgresql+psycopg://transit:transit@127.0.0.1:5432/transit_test
# Worker / API
POLL_SECONDS=30
RETENTION_DAYS=14
STALE_AFTER_SECONDS=300
API_PORT=8000
# 127.0.0.1 (default) keeps the API private to this machine; see docs/DEPLOYMENT.md
API_BIND=127.0.0.1
